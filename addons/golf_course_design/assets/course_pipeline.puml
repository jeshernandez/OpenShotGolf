@startuml
title Golf Course Design Pipeline

top to bottom direction
skinparam backgroundColor #1E1E1E
skinparam shadowing false
skinparam roundcorner 12
skinparam ArrowColor #EAEAEA
skinparam ArrowFontColor white
skinparam ArrowFontSize 20
skinparam defaultFontColor white
skinparam defaultFontSize 20
skinparam defaultTextAlignment center
skinparam NoteBackgroundColor #2A2A2A
skinparam NoteBorderColor #BBBBBB
skinparam NoteFontColor white
skinparam NoteFontSize 19

rectangle "Designer" as Designer #33415C

package "Gather public source data" #292929 {
  rectangle "Browser and manual tools\nOpenStreetMap\nOverpass Turbo\nQGIS\nUSGS Downloader\nOpenTopography" as Browser #4A3B24
  rectangle "Optional scripted APIs\nOSM known-way API\nOverpass API\nUSGS TNM Access API\nOpenTopography API" as Api #4A3B24
}

package "Choose prepared inputs" #292929 {
  rectangle "Boundary GeoJSON\noptional DEM crop" as Boundary #624A2E
  rectangle "Hole lines GeoJSON\noptional import and zones" as HoleLines #624A2E
  rectangle "Bunker GeoJSON\noptional sand zones" as Bunkers #624A2E
  rectangle "GeoTIFF DEM\nHeightmap mode" as Dem #624A2E
  rectangle "LAS or LAZ lidar\nPoint cloud mode" as Lidar #624A2E
  rectangle "Existing Terrain3D folder\nManual or external mode" as ExternalTerrain #624A2E
}

rectangle "Golf Course\nDesign Dock" as Dock #30445A
rectangle "course_design.tres\neditable settings" as ProjectFile #2F4A3E
rectangle "GDAL + OGR" as Gdal #46314F
rectangle "PDAL rasterization" as Pdal #46314F
rectangle "Staged terrain\n.golf_course_design/" as Staging #294E4A
rectangle "Terrain3D data\nTerrain/" as TerrainFolder #2F3F57
rectangle "Shared base scene\ncourse_base.tscn" as BaseScene #34425C
rectangle "Shared gameplay\ncourse_play.gd" as CoursePlay #34425C
rectangle "course.gd\nextends CoursePlay" as ScriptFile #3C3C3C
rectangle "course.json\ncourse metadata" as JsonFile #3C3C3C
rectangle "course.tscn\none playable scene" as SceneFile #3C3C3C
rectangle "Godot 3D view\nand course selector" as GodotView #274A5A

Designer --> Browser : point-and-click path
Designer --> Api : repeatable scripted path
Browser --> Boundary
Browser --> HoleLines
Browser --> Bunkers
Browser --> Dem
Browser --> Lidar
Api --> Boundary
Api --> HoleLines
Api --> Dem
Api --> Lidar

Boundary --> Dock : optional crop
HoleLines --> Dock : optional import and painting
Bunkers --> Dock : optional painting
Dem --> Dock : Heightmap
Lidar --> Dock : Point cloud
ExternalTerrain --> Dock : Manual or external data

Dock --> ProjectFile : Save
ProjectFile --> Dock : Load
Dock --> Pdal : point-cloud build
Lidar --> Pdal
Pdal --> Gdal : raster heightmap
Dock --> Gdal : heightmap build
Dem --> Gdal
Boundary --> Gdal : crop raster
HoleLines --> Gdal : fairways, tees,\nand greens
Bunkers --> Gdal : sand zones
Gdal --> Staging : fill gaps,\nwrite EXR,\npaint zones
ExternalTerrain --> Staging : copy folder
Staging --> TerrainFolder : replace only\nafter success

Dock --> ScriptFile : Export
Dock --> JsonFile : Export
Dock --> SceneFile : Export
TerrainFolder --> SceneFile : referenced by
BaseScene --> SceneFile : inherited root
CoursePlay ..> ScriptFile : inherited behavior
ScriptFile --> SceneFile : course script
JsonFile --> SceneFile : runtime hole data
SceneFile --> GodotView : preview and play

note right of Dem
Use a DEM first when it is available.
Lidar is optional and usually larger.
end note

note right of HoleLines
Holes can also be entered by hand.
Generated zones need numeric hole refs.
end note

note right of Staging
Heightmap and lidar builds are staged first.
An existing Terrain/ folder is moved to a
timestamped backup before replacement.
end note

note right of TerrainFolder
Generated class maps paint rough, fairway,
green, and optional sand texture slots.
Fine edits still happen in Terrain3D.
end note

note right of SceneFile
The export is one scene for the full course,
not one scene per hole.
end note

@enduml
